# --- Web app -----------------------------------------------------------------
# Required whenever the web app is reachable beyond localhost (e.g. Docker/cloud).
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(24))"
SALESBOT_WEB_TOKEN=
SALESBOT_WEB_HOST=127.0.0.1
SALESBOT_WEB_PORT=8000

# --- Telegram (talk to your team) -------------------------------------------
# Create a bot with @BotFather and paste its token here.
TELEGRAM_BOT_TOKEN=
# Comma-separated Telegram user IDs allowed to command the team.
# Message the bot once; it replies with your ID if you're not on the list.
TELEGRAM_ALLOWED_USER_IDS=

# --- LLM providers (add the ones you use) ----------------------------------
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
XAI_API_KEY=
GEMINI_API_KEY=
# Or use "Sign in with OpenRouter" in the web app's Connections instead of a key.
OPENROUTER_API_KEY=

# Model for the Manager, HR and Recruiter: "<provider>:<model>".
# Leave empty to auto-pick from what's connected: Claude API key, then the signed-in
# Claude Code CLI, then OpenRouter / OpenAI / xAI / Gemini. Also settable in Connections.
SALESBOT_DEFAULT_MODEL=
# Default model per provider, used when a bot's spec names only the provider.
ANTHROPIC_MODEL=claude-opus-5-5
OPENAI_MODEL=gpt-5
XAI_MODEL=grok-4
GEMINI_MODEL=gemini-2.5-pro
OPENROUTER_MODEL=openrouter/auto
# Model for the claude_code provider; "default" lets the CLI choose.
CLAUDE_CODE_MODEL=default

# --- Email (SMTP) -----------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# --- SMS (Twilio) -----------------------------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# --- Free / extra AI providers and the API router --------------------------
# Groq free tier (console.groq.com) and a local Ollama server (e.g. Qwen) as extra providers.
GROQ_API_KEY=
OLLAMA_URL=
# Set SALESBOT_DEFAULT_MODEL=router to route through a chain of models with automatic
# fallback. Leave ROUTER_MODELS empty to use the free API hunter's chain
# (`python -m salesbot hunt`, or "Hunt free APIs" in Connections; refreshed daily).
ROUTER_MODELS=
ROUTER_PREFER=free

# --- Web search (Brave Search API) ------------------------------------------
BRAVE_API_KEY=

# --- OpenClaw browser agent (formerly Clawdbot), optional ---------------------
# Your OpenClaw Gateway with gateway.http.endpoints.chatCompletions enabled. Keep it on
# localhost/tailnet; salesbot sends research tasks to it with the openclaw_browse tool.
OPENCLAW_URL=
OPENCLAW_TOKEN=
OPENCLAW_AGENT=main
OPENCLAW_TIMEOUT=300

# --- Behaviour ----------------------------------------------------------------
# Queue emails/texts for your /approve before they are sent. Strongly recommended.
SALESBOT_REQUIRE_APPROVAL=true
SALESBOT_MAX_AGENT_STEPS=12
SALESBOT_DATA_DIR=data
LOG_LEVEL=INFO
